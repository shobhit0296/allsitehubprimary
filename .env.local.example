# Copy to .env.local for local development, or set these in the Vercel
# project's Environment Variables settings for production.
#
# Without these set, the app falls back to reading/writing data/db.json on
# disk. That works for `next dev` / `next start` locally, but NOT on Vercel:
# serverless functions there run on a read-only filesystem, so admin edits
# (add/edit/delete site, category, region) will fail or silently not
# persist once deployed. To persist admin edits on Vercel, connect a Redis
# store (Vercel Marketplace -> Upstash, or create one directly at
# upstash.com) and set the REST URL/token it gives you below.

# Accepts either naming convention (whichever your provider injects):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
